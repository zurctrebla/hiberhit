# Supabase (Não mais utilizado - migrado para PostgreSQL próprio)
# VITE_PUBLIC_SUPABASE_URL=
# VITE_PUBLIC_SUPABASE_ANON_KEY=

# PostgreSQL Próprio
DB_HOST=10.0.0.1
DB_PORT=5432
DB_NAME=hiberhit
DB_USER=root
DB_PASSWORD=root
DB_SSL=true

# API Backend
VITE_API_URL=http://localhost:3001
API_PORT=3001
NODE_ENV=production

# JWT Authentication
JWT_SECRET=iberhit_super_secret_key_2024_change_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key_here

# Digital Ocean Spaces Configuration
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_BUCKET=iberhit-assets
DO_SPACES_REGION=lon1
DO_SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com
DO_SPACES_CDN_ENDPOINT=https://iberhit-assets.lon1.cdn.digitaloceanspaces.com

# Storage Configuration (Escolha uma opção e configure)
# Opção 1: AWS S3
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Opção 2: Azure Blob Storage
# AZURE_STORAGE_ACCOUNT=your-account-name
# AZURE_STORAGE_KEY=your-account-key
# AZURE_STORAGE_CONTAINER=your-container-name

# Opção 3: Google Cloud Storage
# GCS_BUCKET=your-bucket-name
# GCS_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Opção 4: Storage Local (padrão)
UPLOAD_DIR=./uploads

# Holded CRM (opcional)
# HOLDED_API_KEY=your_holded_api_key_here
